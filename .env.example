# development | staging | production
APP_ENV=development
API_V1_PREFIX=/api/v1
# Em produção use HTTPS: https://seu-dominio.com
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://127.0.0.1:5173

API_HOST_PORT=8000

APP_NAME=Advocacia API
APP_VERSION=0.1.0

POSTGRES_USER=advocacia_user
POSTGRES_PASSWORD=senha-forte-aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=advocacia_db

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@seu-dominio.com

DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=10
DATAJUD_MAX_RETRIES=2
DATAJUD_RETRY_BACKOFF_SECONDS=0.5
DATAJUD_SYNC_INTERVAL_HOURS=6
DATAJUD_SYNC_LIMIT=50
DATAJUD_SYNC_USER_ID=0
INTEGRATION_FAILURE_EMAIL_THROTTLE_MINUTES=30

UPLOAD_DIR=uploads/media
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/gif"]

LEAD_DEDUP_WINDOW_HOURS=1

KANBAN_MAX_PER_COLUMN=100

SCHEDULER_ENABLED=false
DEADLINE_ALERT_CRON=06:00
DEADLINE_ALERT_INTERVALS=30,15,7,3,2,1

# Integração Google Calendar, ver README para o setup.
# Deixe em branco para manter a integração desabilitada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
