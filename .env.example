# development | staging | production
APP_ENV=development
API_V1_PREFIX=/api/v1
# Em produção use HTTPS: https://seu-dominio.com
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://127.0.0.1:5173

API_HOST_PORT=8000

APP_NAME=Advocacia API
APP_VERSION=0.1.0

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=bessaz
POSTGRES_PORT=5432
POSTGRES_DB=advocacia_db

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="dummy"
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
# Convite de usuário: validade do link e limite de reenvios por usuário.
INVITE_EXPIRE_HOURS=48
INVITE_RESEND_LIMIT_PER_HOUR=3

# Ordem do failover (primário, reserva). Vazio = e-mails só em memória (dev/teste).
# No docker compose local o override aponta para o Mailpit (http://localhost:8025).
EMAIL_PROVIDERS=smtp,resend
EMAIL_MAX_SIZE_MB=10

# SMTP do Google (Gmail). Exige verificação em 2 etapas e uma "senha de app":
# https://myaccount.google.com/apppasswords (16 caracteres, sem espaços).
# 587 + starttls ou 465 + ssl. SMTP_FROM_EMAIL deve ser a própria conta ou um
# alias verificado em "Enviar e-mail como". Limite: ~500 destinatários/dia
# (Gmail pessoal) ou ~2000 (Workspace).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=conta@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=conta@gmail.com
SMTP_FROM_NAME=Escritório de Advocacia
SMTP_TIMEOUT_SECONDS=15

# Perfis salvos pela tela (Sistema > Configurações de e-mail) têm prioridade
# sobre as variáveis acima. As senhas ficam criptografadas com estas chaves
# Fernet (separadas por vírgula; a primeira encripta). Para trocar a chave:
# coloque a nova na frente, rode `python -m scripts.rotate_email_keys` e
# depois remova a antiga. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEYS=

# Fila de saída de e-mails (worker no scheduler)
EMAIL_OUTBOX_INTERVAL_SECONDS=30
EMAIL_OUTBOX_BATCH_SIZE=50
EMAIL_OUTBOX_STUCK_MINUTES=10
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_RETRY_MAX_SECONDS=21600
EMAIL_MAX_ATTEMPTS=6

# Reserva (opcional). Sem chave, o Resend é ignorado no failover.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@seu-dominio.com




DATAJUD_API_KEY="dummy"
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=10
DATAJUD_MAX_RETRIES=2
DATAJUD_RETRY_BACKOFF_SECONDS=0.5
DATAJUD_SYNC_INTERVAL_HOURS=6
DATAJUD_SYNC_LIMIT=50
DATAJUD_SYNC_USER_ID=1
INTEGRATION_FAILURE_EMAIL_THROTTLE_MINUTES=30

UPLOAD_DIR=uploads/media
MAX_FILE_SIZE_MB=5
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/gif"]
DOCUMENTS_UPLOAD_DIR=uploads/documents
DOCUMENT_MAX_FILE_SIZE_MB=20
DOCUMENT_ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

LEAD_DEDUP_WINDOW_HOURS=1

KANBAN_MAX_PER_COLUMN=100

SCHEDULER_ENABLED=false
DEADLINE_ALERT_CRON=06:00
DEADLINE_ALERT_INTERVALS=30,15,7,3,2,1

# Integração Google Calendar, ver README para o setup.
# Deixe em branco para manter a integração desabilitada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
